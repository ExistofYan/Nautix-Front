i{\n\npadding:12px;\n\nbackground:#17324d;\n\nborder-radius:10px;\n\ncolor:white;\n\n}\n\n</style>", "src/layouts/FloatingPanel.vue": "<template>\n\n<div class=\"floating\">\n\n<slot/>\n\n</div>\n\n</template>\n\n<script setup lang=\"ts\">\n</script>\n\n<style scoped>\n\n.floating{\n\nposition:absolute;\n\nright:20px;\n\ntop:20px;\n\npadding:16px;\n\nbackground:rgba(20,40,60,.85);\n\nbackdrop-filter:blur(10px);\n\nborder-radius:12px;\n\ncolor:white;\n\n}\n\n</style>", "src/views/simulator/Simulator.vue": "<template>\n  <div>\n    Simulator Page\n  </div>\n</template>\n\n<script setup lang=\"ts\">\n\n</script>", "src/components/ai/AIResponseCard.vue": "<template>\n\n<div>\n\nAI Response\n\n</div>\n\n</template>\n\n\n<script setup lang=\"ts\">\n\n</script>", "src/components/ai/InsightCard.vue": "<template>\n\n<div>\n\nAI Insight\n\n</div>\n\n</template>\n\n\n<script setup lang=\"ts\">\n\n</script>", "src/components/ai/QueryInput.vue": "<template>\n\n<input placeholder=\"Ask Nautix AI\"/>\n\n</template>\n\n\n<script setup lang=\"ts\">\n\n</script>", "src/components/ai/RecommendationPanel.vue": "<template>\n\n<div>\n\nRecommendation\n\n</div>\n\n\n</template>\n\n\n<script setup lang=\"ts\">\n\n</script>", "src/views/earth/Earth.vue": "<template>\n\n\n<FullScreenLayout>\n\n\n<div class=\"earth\">\n\n\n<CesiumViewer\n\n@shipSelected=\"openShip\"\n\n/>\n\n\n\n<div class=\"title\">\n\n\nDigital Earth\n\n\n</div>\n\n\n\n<div class=\"center-panel\">\n\n\nOcean Digital Twin\n\n\n</div>\n\n\n\n<ShipDetailDrawer\n\n:ship=\"selectedShip\"\n\n/>\n\n\n\n</div>\n\n\n</FullScreenLayout>\n\n\n</template>\n\n\n\n<script setup lang=\"ts\">\n\n\nimport {ref} from 'vue'\n\n\nimport FullScreenLayout\n\nfrom '@/layouts/FullScreenLayout.vue'\n\n\nimport CesiumViewer\n\nfrom '@/components/map/CesiumViewer.vue'\n\n\nimport ShipDetailDrawer\n\nfrom '@/components/ship/ShipDetailDrawer.vue'\n\n\n\nconst selectedShip = ref<any>()\n\n\n\nfunction openShip(id:number){\n\n\nselectedShip.value={\n\n\nid,\n\n\nname:\"Nautix Explorer\",\n\n\nimo:\"IMO-\"+id,\n\n\nspeed:18.5,\n\n\nfuel:75,\n\n\nengineLoad:42\n\n\n}\n\n\n}\n\n\n\n</script>\n\n\n\n<style scoped>\n\n\n.earth{\n\n\nwidth:100%;\n\n\nheight:100%;\n\n\nposition:relative;\n\n\noverflow:hidden;\n\n\nbackground:\n\n\nradial-gradient(\n\ncircle,\n\n#"}
